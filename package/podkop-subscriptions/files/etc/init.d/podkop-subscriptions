#!/bin/sh /etc/rc.common

START=98
USE_PROCD=1

start_service() {
	config_load podkop-subscriptions
	config_get enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/podkop-subscriptions daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	/etc/init.d/podkop-subscriptions restart
}

